{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgileEye",
  "version": "0.1.0",
  "identifier": "com.agileeye.prototype",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgileEye",
        "width": 1280,
        "height": 820,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
